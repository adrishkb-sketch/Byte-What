# BYTE WHAT - Environment Variables

# ==============================================================================
# 1. Database Configuration (100% Free: Neon Serverless Postgres / Vercel Postgres)
# ==============================================================================
# Sign up free at https://neon.tech (No credit card required) or use Vercel Postgres.
# Paste your Neon connection string below:
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-flower-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"

# (Optional) If using Supabase instead:
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# 2. Google AI Studio Gemini API Key(s) (Optional - Fallback works automatically)
# ==============================================================================
# Provide 1 or up to 15-16 keys as a comma-separated list:
GEMINI_API_KEYS="AIzaSyA..., AIzaSyB..., AIzaSyC..."
GEMINI_MODEL="gemini-1.5-flash"

# ==============================================================================
# 3. College Branding
# ==============================================================================
NEXT_PUBLIC_COLLEGE_NAME="Government College of Engineering and Ceramic Technology (GCECT)"
NEXT_PUBLIC_PLATFORM_NAME="BYTE WHAT"
